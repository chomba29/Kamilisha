<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_card" targetNamespace="https://github.com/kamilisha" exporter="kamilisha build_maps.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_card">
    <bpmn:participant id="Pool_card" name="Fictional bank · branch — Map 2 — Card replacement (as-is)" processRef="Process_card" />
    <bpmn:textAnnotation id="m2_n1"><bpmn:text>Old circular (v1): block on the system, no form needed. Current circular (v2): signed blocking form first, then block. Habit still follows v1 (P1, P2).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_m2_n1" sourceRef="m2_ver" targetRef="m2_n1" />
    <bpmn:textAnnotation id="m2_n2"><bpmn:text>Skipping the form (P4) is caught by QA, later by an audit query, or not at all: the lost card keeps transacting and the bank takes a fraud loss.</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_card" name="Map 2 — Card replacement (as-is)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_card">
      <bpmn:lane id="Lane_card_0" name="Customer">
        <bpmn:flowNodeRef>m2_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_card_1" name="Branch officer">
        <bpmn:flowNodeRef>m2_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2_ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2_hand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_card_2" name="Supervisor">
        <bpmn:flowNodeRef>m2_auth</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_card_3" name="Card centre">
        <bpmn:flowNodeRef>m2_make</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_card_4" name="Back office (QA)">
        <bpmn:flowNodeRef>m2_qa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m2_exc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="m2_start" name="Asks to replace a lost or damaged card">
      <bpmn:outgoing>Flow_m2_start_m2_id</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="m2_id" name="Verify customer identity">
      <bpmn:documentation>CONTROL STEP</bpmn:documentation>
      <bpmn:incoming>Flow_m2_start_m2_id</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_id_m2_ver</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m2_ver" name="Which circular does the officer follow?">
      <bpmn:documentation>Pain points: P1, P2</bpmn:documentation>
      <bpmn:incoming>Flow_m2_id_m2_ver</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_ver_m2_form</bpmn:outgoing>
      <bpmn:outgoing>Flow_m2_ver_m2_block</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="m2_form" name="Obtain signed card-blocking form">
      <bpmn:documentation>CONTROL STEP; Pain points: P4</bpmn:documentation>
      <bpmn:incoming>Flow_m2_ver_m2_form</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_form_m2_block</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="m2_block" name="Block old card on the card system">
      <bpmn:documentation>CONTROL STEP</bpmn:documentation>
      <bpmn:incoming>Flow_m2_ver_m2_block</bpmn:incoming>
      <bpmn:incoming>Flow_m2_form_m2_block</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_block_m2_req</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="m2_req" name="Capture replacement request; charge fee">
      <bpmn:incoming>Flow_m2_block_m2_req</bpmn:incoming>
      <bpmn:incoming>Flow_m2_auth_m2_req</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_req_m2_auth</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m2_auth" name="Authorise?">
      <bpmn:incoming>Flow_m2_req_m2_auth</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_auth_m2_make</bpmn:outgoing>
      <bpmn:outgoing>Flow_m2_auth_m2_req</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="m2_make" name="Produce new card">
      <bpmn:incoming>Flow_m2_auth_m2_make</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_make_m2_qa</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m2_qa" name="Old card confirmed blocked and form on file?">
      <bpmn:documentation>Pain points: P3</bpmn:documentation>
      <bpmn:incoming>Flow_m2_make_m2_qa</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_qa_m2_exc</bpmn:outgoing>
      <bpmn:outgoing>Flow_m2_qa_m2_hand</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="m2_exc" name="Block card; raise exception to branch">
      <bpmn:incoming>Flow_m2_qa_m2_exc</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_exc_m2_hand</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="m2_hand" name="Hand over new card after ID check">
      <bpmn:documentation>CONTROL STEP</bpmn:documentation>
      <bpmn:incoming>Flow_m2_qa_m2_hand</bpmn:incoming>
      <bpmn:incoming>Flow_m2_exc_m2_hand</bpmn:incoming>
      <bpmn:outgoing>Flow_m2_hand_m2_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="m2_end" name="Replacement complete">
      <bpmn:incoming>Flow_m2_hand_m2_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_m2_start_m2_id" sourceRef="m2_start" targetRef="m2_id" />
    <bpmn:sequenceFlow id="Flow_m2_id_m2_ver" sourceRef="m2_id" targetRef="m2_ver" />
    <bpmn:sequenceFlow id="Flow_m2_ver_m2_form" name="Current (v2)" sourceRef="m2_ver" targetRef="m2_form" />
    <bpmn:sequenceFlow id="Flow_m2_ver_m2_block" name="Habit (old v1): form skipped" sourceRef="m2_ver" targetRef="m2_block" />
    <bpmn:sequenceFlow id="Flow_m2_form_m2_block" sourceRef="m2_form" targetRef="m2_block" />
    <bpmn:sequenceFlow id="Flow_m2_block_m2_req" sourceRef="m2_block" targetRef="m2_req" />
    <bpmn:sequenceFlow id="Flow_m2_req_m2_auth" sourceRef="m2_req" targetRef="m2_auth" />
    <bpmn:sequenceFlow id="Flow_m2_auth_m2_make" name="Yes" sourceRef="m2_auth" targetRef="m2_make" />
    <bpmn:sequenceFlow id="Flow_m2_auth_m2_req" name="No: correct" sourceRef="m2_auth" targetRef="m2_req" />
    <bpmn:sequenceFlow id="Flow_m2_make_m2_qa" sourceRef="m2_make" targetRef="m2_qa" />
    <bpmn:sequenceFlow id="Flow_m2_qa_m2_exc" name="No" sourceRef="m2_qa" targetRef="m2_exc" />
    <bpmn:sequenceFlow id="Flow_m2_qa_m2_hand" name="Yes" sourceRef="m2_qa" targetRef="m2_hand" />
    <bpmn:sequenceFlow id="Flow_m2_exc_m2_hand" sourceRef="m2_exc" targetRef="m2_hand" />
    <bpmn:sequenceFlow id="Flow_m2_hand_m2_end" sourceRef="m2_hand" targetRef="m2_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_card"><bpmndi:BPMNPlane id="Plane_card" bpmnElement="Collab_card">
    <bpmndi:BPMNShape id="Pool_card_di" bpmnElement="Pool_card" isHorizontal="true"><dc:Bounds x="40" y="150" width="2408" height="800" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_card_0_di" bpmnElement="Lane_card_0" isHorizontal="true"><dc:Bounds x="74" y="150" width="2374" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_card_1_di" bpmnElement="Lane_card_1" isHorizontal="true"><dc:Bounds x="74" y="310" width="2374" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_card_2_di" bpmnElement="Lane_card_2" isHorizontal="true"><dc:Bounds x="74" y="470" width="2374" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_card_3_di" bpmnElement="Lane_card_3" isHorizontal="true"><dc:Bounds x="74" y="630" width="2374" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_card_4_di" bpmnElement="Lane_card_4" isHorizontal="true"><dc:Bounds x="74" y="790" width="2374" height="160" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_start_di" bpmnElement="m2_start"><dc:Bounds x="214" y="211" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_id_di" bpmnElement="m2_id"><dc:Bounds x="345" y="353" width="156" height="74" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_ver_di" bpmnElement="m2_ver"><dc:Bounds x="586" y="363" width="54" height="54" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_form_di" bpmnElement="m2_form"><dc:Bounds x="725" y="353" width="156" height="74" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_block_di" bpmnElement="m2_block"><dc:Bounds x="915" y="353" width="156" height="74" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_req_di" bpmnElement="m2_req"><dc:Bounds x="1105" y="353" width="156" height="74" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_auth_di" bpmnElement="m2_auth"><dc:Bounds x="1346" y="523" width="54" height="54" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_make_di" bpmnElement="m2_make"><dc:Bounds x="1485" y="673" width="156" height="74" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_qa_di" bpmnElement="m2_qa"><dc:Bounds x="1726" y="843" width="54" height="54" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_exc_di" bpmnElement="m2_exc"><dc:Bounds x="1865" y="833" width="156" height="74" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_hand_di" bpmnElement="m2_hand"><dc:Bounds x="2055" y="353" width="156" height="74" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="m2_end_di" bpmnElement="m2_end"><dc:Bounds x="2304" y="371" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_m2_start_m2_id_di" bpmnElement="Flow_m2_start_m2_id"><di:waypoint x="252" y="230" /><di:waypoint x="423" y="230" /><di:waypoint x="423" y="353" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_id_m2_ver_di" bpmnElement="Flow_m2_id_m2_ver"><di:waypoint x="501" y="390" /><di:waypoint x="586" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_ver_m2_form_di" bpmnElement="Flow_m2_ver_m2_form"><di:waypoint x="640" y="390" /><di:waypoint x="725" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_ver_m2_block_di" bpmnElement="Flow_m2_ver_m2_block"><di:waypoint x="613" y="417" /><di:waypoint x="613" y="452" /><di:waypoint x="993" y="452" /><di:waypoint x="993" y="427" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_form_m2_block_di" bpmnElement="Flow_m2_form_m2_block"><di:waypoint x="881" y="390" /><di:waypoint x="915" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_block_m2_req_di" bpmnElement="Flow_m2_block_m2_req"><di:waypoint x="1071" y="390" /><di:waypoint x="1105" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_req_m2_auth_di" bpmnElement="Flow_m2_req_m2_auth"><di:waypoint x="1261" y="390" /><di:waypoint x="1373" y="390" /><di:waypoint x="1373" y="523" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_auth_m2_make_di" bpmnElement="Flow_m2_auth_m2_make"><di:waypoint x="1373" y="577" /><di:waypoint x="1373" y="710" /><di:waypoint x="1485" y="710" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_auth_m2_req_di" bpmnElement="Flow_m2_auth_m2_req"><di:waypoint x="1346" y="550" /><di:waypoint x="1183" y="550" /><di:waypoint x="1183" y="427" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_make_m2_qa_di" bpmnElement="Flow_m2_make_m2_qa"><di:waypoint x="1563" y="747" /><di:waypoint x="1563" y="870" /><di:waypoint x="1726" y="870" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_qa_m2_exc_di" bpmnElement="Flow_m2_qa_m2_exc"><di:waypoint x="1780" y="870" /><di:waypoint x="1865" y="870" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_qa_m2_hand_di" bpmnElement="Flow_m2_qa_m2_hand"><di:waypoint x="1753" y="843" /><di:waypoint x="1753" y="390" /><di:waypoint x="2055" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_exc_m2_hand_di" bpmnElement="Flow_m2_exc_m2_hand"><di:waypoint x="2021" y="870" /><di:waypoint x="2133" y="870" /><di:waypoint x="2133" y="427" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_m2_hand_m2_end_di" bpmnElement="Flow_m2_hand_m2_end"><di:waypoint x="2211" y="390" /><di:waypoint x="2304" y="390" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="m2_n1_di" bpmnElement="m2_n1"><dc:Bounds x="353.0" y="490" width="360" height="65" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Assoc_m2_n1_di" bpmnElement="Assoc_m2_n1"><di:waypoint x="613" y="390" /><di:waypoint x="353.0" y="522" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="m2_n2_di" bpmnElement="m2_n2"><dc:Bounds x="773.0" y="492" width="330" height="82" /></bpmndi:BPMNShape>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>